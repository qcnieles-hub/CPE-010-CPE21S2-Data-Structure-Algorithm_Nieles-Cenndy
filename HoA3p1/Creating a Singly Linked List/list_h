#ifndef LIST_H
#define LIST_H

#include <iostream>

// Define template type parameter
template <typename T>
class SinglyList {
public:
    T data;
    SinglyList<T>* next;
};

// Function to print the entire list
template <typename T>
void ListTraversal(SinglyList<T>* node) {
    if (node == nullptr) {
        std::cout << "The list is empty" << std::endl;
        return;
    }

    while (node != nullptr) {
        std::cout << node->data << " ";
        node = node->next;
    }
    std::cout << std::endl;
}

// 1. Function to insert a new node at the head
template <typename T>
void s11InsertHead(T newData, SinglyList<T>** currentHead) {
    // Allocate memory for the new node
    SinglyList<T>* newNode = new SinglyList<T>();
    
    // Put data into the new node
    newNode->data = newData;
    
    // Set next of the new node to point to the previous head
    newNode->next = *currentHead;
    
    // Reset head to point to the new node
    *currentHead = newNode;
}

// 2. Function to insert a new node at any position after a given node
template <typename T>
void s11GeneralInsert(T newData, SinglyList<T>* prevNode) {
    // Check if the previous node is null
    if (prevNode == nullptr) {
        std::cout << "Previous node cannot be null." << std::endl;
        return;
    }

    // Allocate a new node
    SinglyList<T>* newNode = new SinglyList<T>();
    newNode->data = newData;

    // Set the new node's next to what the previous node was pointing to
    newNode->next = prevNode->next;

    // Point the previous node to the new node
    prevNode->next = newNode;
}

// 3. Function to insert a new node at the very end of the list
template <typename T>
void s11InsertEnd(T newData, SinglyList<T>** currentHead) {
    // Allocate memory for the new node
    SinglyList<T>* newNode = new SinglyList<T>();
    newNode->data = newData;
    newNode->next = nullptr;

    // If the list is empty, make the new node the head
    if (*currentHead == nullptr) {
        *currentHead = newNode;
        return;
    }

    // Traverse to the last node
    SinglyList<T>* last = *currentHead;
    while (last->next != nullptr) {
        last = last->next;
    }

    // Link the old last node to the new node
    last->next = newNode;
}

// 4. Function to delete a specific node by its value match
template <typename T>
void s11DeleteNode(T targetData, SinglyList<T>** currentHead) {
    SinglyList<T>* temp = *currentHead;
    SinglyList<T>* prev = nullptr;

    // If head node itself holds the target data
    if (temp != nullptr && temp->data == targetData) {
        *currentHead = temp->next; // Changed head
        delete temp;               // Free old head memory
        return;
    }

    // Search for the target data to be deleted
    while (temp != nullptr && temp->data != targetData) {
        prev = temp;
        temp = temp->next;
    }

    // If the target data was not present in the list
    if (temp == nullptr) return;

    // Unlink the node from linked list
    prev->next = temp->next;

    // Free memory
    delete temp;
}

// 5. Function to delete the entire list to prevent memory leaks
template <typename T>
void s11DeleteList(SinglyList<T>** currentHead) {
    SinglyList<T>* current = *currentHead;
    SinglyList<T>* nextNode = nullptr;

    while (current != nullptr) {
        nextNode = current->next;
        delete current;
        current = nextNode;
    }

    *currentHead = nullptr;
}
#endif
