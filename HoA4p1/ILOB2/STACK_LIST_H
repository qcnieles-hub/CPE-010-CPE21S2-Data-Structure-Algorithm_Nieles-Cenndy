#ifndef STACK_LIST_H
#define STACK_LIST_H

//class node that contains data and the next
template<typename T>
class Node{
    public:
        T data;
        Node<T>* next;
};

//global pointer for the top of the stack
template<typename T>
Node<T>* top = nullptr;

//Operation for the stack

//push
template <typename T>
void push(T newData){
    //create a new node and assign the newData
    Node<T>* newNode = new Node<T>();
    newNode->data = newData;

    //new node points to current top, then becomes the new top
    newNode->next = top<T>;
    top<T> = newNode;

}
//pop
template <typename T>
T pop() {
    if(top<T> == nullptr) {
     std::cout << "stack underflow. " << std::endl;
      return T();
       
    }
//save the current top node
    Node<T>* temp = top<T>;
    //store its data
    T templateVal = temp->data;

   //move the top to the next node
   top<T> = temp->next;
   //free the removed node
   delete temp;
   //return the removed value
   return templateVal;

}

// isEmpty
template <typename T>
bool isEmpty() {
   return top<T> == nullptr;
}   
 
   // top
    template <typename T>
    void Top() {
        // error catching:
        if(isEmpty<T>()) {
            std::cout << "stack underflow "<<std::endl;
            return;
        }
        //display the Top node
        std::cout << "Top of Stack: " <<top<T>->data <<std::endl;
        
    }

    //display All
    template <typename T>
    void displayAll() {
        if (top<T> ==  nullptr) {
            std::cout << "stack undeflow\n";
            return;
        }
        std::cout<< "Displaying the stack: \n";
        Node<T>* temp = top<T>;
        while (temp != nullptr) {
            std::cout << temp->data << "\n"; 
            temp = temp->next;
        }
        std::cout << "\n";
    }

#endif
    
